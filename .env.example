# Gift Registry — environment configuration.
#
# Copy this file to `.env` and fill in the values. `scripts/glist` forwards these
# to Flutter as --dart-define at run/build time. Not needed while the app runs on
# in-memory mock repositories (the current default) — only for the Supabase phase.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon (public) key. Safe to ship in the web bundle — RLS is the real
# security boundary. Do NOT put the service_role key here.
SUPABASE_ANON_KEY=
