#!/usr/bin/env bash
#
# glist — Gift Registry developer CLI
#
# A single self-documenting entrypoint for building, running, and checking the
# Flutter Web app. Wraps `flutter`/`dart` so contributors don't memorize flags.
#
# Usage:
#   ./scripts/glist run [device]      Run the web app (default device: chrome)
#   ./scripts/glist build             Build a web release (build/web)
#   ./scripts/glist analyze           Static analysis (run after every change)
#   ./scripts/glist format            Format all Dart code
#   ./scripts/glist test [args...]    Run tests (extra args passed through)
#   ./scripts/glist check             analyze + format --set-exit-if-changed + test
#   ./scripts/glist get               flutter pub get
#   ./scripts/glist supabase <cmd>    (stub) Supabase migrations — wired in phase 8
#
# Environment:
#   Reads ./.env if present (SUPABASE_URL, SUPABASE_ANON_KEY) and forwards them
#   to Flutter as --dart-define. Missing .env is fine while on mock repositories.
#
# Portable to Bash 3.2 (the default on macOS) — no mapfile/associative arrays.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

# Prefer the FVM-pinned Flutter if available, else the Flutter on PATH.
if command -v fvm >/dev/null 2>&1 && [[ -d "$ROOT_DIR/.fvm" ]]; then
  FLUTTER=(fvm flutter)
  DART=(fvm dart)
else
  FLUTTER=(flutter)
  DART=(dart)
fi

# Populates the global DEFINES array with --dart-define args from .env (if any).
DEFINES=()
load_dart_defines() {
  DEFINES=()
  if [[ -f "$ROOT_DIR/.env" ]]; then
    # shellcheck disable=SC1091
    set -a
    source "$ROOT_DIR/.env"
    set +a
    if [[ -n "${SUPABASE_URL:-}" ]]; then
      DEFINES+=("--dart-define=SUPABASE_URL=$SUPABASE_URL")
    fi
    if [[ -n "${SUPABASE_ANON_KEY:-}" ]]; then
      DEFINES+=("--dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY")
    fi
  fi
}

usage() {
  # Print the leading comment block (skip the shebang), stopping at the first
  # non-comment line, and strip the leading "# ".
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"
}

cmd="${1:-}"
shift || true
case "$cmd" in
  run)
    device="${1:-chrome}"
    load_dart_defines
    exec "${FLUTTER[@]}" run -d "$device" ${DEFINES[@]+"${DEFINES[@]}"}
    ;;
  build)
    load_dart_defines
    exec "${FLUTTER[@]}" build web ${DEFINES[@]+"${DEFINES[@]}"} "$@"
    ;;
  analyze)
    exec "${FLUTTER[@]}" analyze "$@"
    ;;
  format)
    if [[ $# -gt 0 ]]; then
      exec "${DART[@]}" format "$@"
    else
      exec "${DART[@]}" format .
    fi
    ;;
  test)
    exec "${FLUTTER[@]}" test "$@"
    ;;
  check)
    "${FLUTTER[@]}" analyze
    "${DART[@]}" format --set-exit-if-changed .
    "${FLUTTER[@]}" test
    ;;
  get)
    exec "${FLUTTER[@]}" pub get
    ;;
  supabase)
    echo "supabase commands are a stub until phase 8 (schema, RLS, RPCs, storage)." >&2
    echo "Planned: 'glist supabase push' / 'glist supabase reset' via the Supabase CLI." >&2
    exit 1
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo >&2
    usage
    exit 1
    ;;
esac
